    "eslint": "10.9.1",
    "eslint-plugin-security": "4.0.1",
    "jsdom": "30.0.1",
    "msw": "2.15.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "vitest-axe": "0.1.0"
