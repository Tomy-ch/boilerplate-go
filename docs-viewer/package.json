    "hast-util-to-jsx-runtime": "2.3.6",
    "highlight.js": "11.12.0",
    "lucide-react": "1.39.0",
    "marked": "18.0.11",
    "mermaid": "11.17.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
