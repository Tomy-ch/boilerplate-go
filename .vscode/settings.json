{
  "mise.configureExtensionsAutomatically": false,
  "debug.javascript.defaultRuntimeExecutable": {
    "pwa-node": "${env:HOME}/.local/share/mise/shims/node"
  },
  "go.alternateTools": {
    "go": "${env:HOME}/.local/share/mise/shims/go",
    "dlv": "${env:HOME}/.local/share/mise/shims/dlv",
    "gopls": "${env:HOME}/.local/share/mise/shims/gopls"
  },

  "go.lintTool": "golangci-lint-v2",
  // 保存ごとの pass は最小構成を明示的に指す。暗黙探索の既定は権威ゲート(.golangci.yaml)で、
  // それを保存ごとに回すと数分かかる（ADR-0088）。
  "go.lintFlags": ["--config=${workspaceFolder}/.golangci-min.yaml"],
  "go.lintOnSave": "package",
  "go.useLanguageServer": true,

  "gopls": {
    "usePlaceholders": true,
    "formatting.gofumpt": true,
    "completeUnimported": true,
    "matcher": "Fuzzy",
    "staticcheck": true,
    "analyses": {
      "nilness": true,
      "unusedparams": true,
      "unusedvariable": true,
      "shadow": true
    },
    "build.directoryFilters": [
      "-node_modules",
      "-vendor",
      "-dist",
      "-tmp"
    ]
  },

  "material-icon-theme.folders.associations": {
    "actions": "gh-workflows",
    "internal": "private",
    "apperror": "error",
    "testkit": "test",
    "ctxhelper": "context",
    "httpstack": "middleware",
    "di": "interceptor",
    "domain": "core",
    "infrastructure": "connection",
    "rdb": "database",
    "conv": "tools",
    "driver": "connection",
    "integration": "test",
    "observability": "meta",
    "usecase": "tasks",
    "tx": "taskfile",
    "openapi": "api",
    "paths": "routes",
    "xerrors": "error",
  },

  "[go]": {
    "editor.insertSpaces": false,
    "editor.tabSize": 4,
    "editor.detectIndentation": false,
		"editor.guides.indentation": true,
    "editor.formatOnSave": true
  },
	"[markdown]": {
		"editor.tabSize": 2,
		"editor.formatOnSave": true,
		"editor.formatOnPaste": true
	},
  "[javascriptreact]": {
    "editor.tabSize": 2,
		"editor.formatOnSave": true,
		"editor.formatOnPaste": true
  },
  "[javascript]": {
    "editor.tabSize": 2,
		"editor.formatOnSave": true,
		"editor.formatOnPaste": true
  },

  "makefile.configureOnOpen": false,
  "editor.suggestSelection": "first",
  "files.watcherExclude": {
    "**/vendor/**": true,
    "**/.git/**": true,
    "**/dist/**": true
  },
  "search.exclude": {
    "**/vendor": true,
    "**/.git/**": true
  },
  "json.schemaDownload.enable": true,
	"editor.codeActionsOnSave": {
		"source.fixAll.markdownlint": "always"
  },
  "json.schemaDownload.trustedDomains": {
    "https://raw.githubusercontent.com": true
  }
}
